<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <title>Edit Book Form</title>
  </head>
  <body style="background-color: whitesmoke;">
    <h1 style="text-align: center; margin-top: 10px; color: goldenrod">
      Update Book
    </h1>

    <div class="container col-4">
      <form method="post" action="/updateBook" enctype="multipart/form-data">
        <div class="mb-3 mt-5">
          <input type="hidden" name="id" value="<%= book.id %>" class="form-control" />
        </div>
        <div class="mb-3 mt-5">
          <label class="form-label">Book Name</label>
          <input type="text" name="book_name" value="<%= book.book_name %>"  class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Author</label>
          <input type="text" name="book_author" value="<%= book.book_author %>" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Price</label>
          <input type="text" name="book_price" value="<%= book.book_price%>" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Language</label>
          <input type="text" name="book_lang" value="<%= book.book_lang %>" class="form-control" required />
        </div>
        <div class="mb-3">
          <label class="form-label">Image</label>
          <img src="../<%= book.book_image %>" alt="<%= book.book_name %>" width="60px" >
          <input type="file" name="book_image" class="form-control"/>
        </div>

        <button type="submit" class="btn btn-warning">Update Book</button>
      </form>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
