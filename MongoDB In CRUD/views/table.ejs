<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <title>Book Management</title>
  </head>
  <body>
    <h1 style="text-align: center; margin-top: 10px; color: goldenrod;">View Book</h1>

    <div class="container col-12">
        <table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">No</th>
      <th scope="col">Book Name</th>
      <th scope="col">Book Author</th>
      <th scope="col">Book Price</th>
      <th scope="col">Book Language</th>
      <th scope="col">Book Image</th>      
      <th scope="col">action</th>      

    </tr>
  </thead>
  <tbody>
    <% allBooks.map((book, index) => { %>
    <tr>
      <th scope="row"><%= index + 1 %></th>
      <td><%= book.book_name %></td>
      <td><%= book.book_author %></td>
      <td><%= book.book_price %></td>
      <td><%= book.book_lang %></td>
      <td><img src="<%= book.book_image %>" alt="" width="60px"></td>
      <td>
        <button class="btn btn-success"><a href="/editBook/<%= book.id %>" style="color: white; text-decoration: none;">Edit</a></button>
        <button class="btn btn-danger"><a href="/deleteBook?BookId=<%= book.id %>" style="color: white; text-decoration: none;">Delete</a></button>
    </td>
    </tr>
    <% }) %>
    
  </tbody>
</table>
<button class="btn btn-primary"><a href="/addBookPage" style="color: white; text-decoration: none;">Add Book</a></button>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
