<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    
    <link rel="stylesheet" href="/css/style.css">
    <title>Edit Member</title>
</head>
<body>

    <header class="gym-header">
        <h1>
        <span style="font-size: 30px;">❚█══█❚</span> IRON STACK
        </h1>
    </header>

    <section class="container col-6 main-content">
        
        <form method="post" action="/updateMember">
            
            <input type="hidden" name="id" value="<%= member.id %>">

            <div class="mb-3 mt-4">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" value="<%= member.fullName %>" class="form-control" required>
            </div>
            
            <div class="row">
                <div class="col mb-3">
                    <label class="form-label">Age</label>
                    <input type="number" name="age" value="<%= member.age %>" class="form-control" required>
                </div>
                <div class="col mb-3">
                    <label class="form-label">Gender (Male/Female)</label>
                    <input type="text" name="gender" value="<%= member.gender %>" class="form-control" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mobile Number</label>
                <input type="text" name="mobile" value="<%= member.mobile %>" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Membership Type (Monthly/Yearly)</label>
                <input type="text" name="membershipType" value="<%= member.membershipType %>" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <input type="text" name="price" value="<%= member.price %>" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Current Weight (kg)</label>
                <input type="number" name="weight" value="<%= member.weight %>" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Status (Active/Expired)</label>
                <input type="text" name="status" value="<%= member.status %>" class="form-control" required>
            </div>

            <button type="submit" class="btn btn-warning w-100">Update Member</button>
            <br><br>
            <center>
                <button type="submit" class="btn btn-warning w-50">Cancel</button>
            </center>
        </form>
    </section>

    <footer class="gym-footer">
        <p>&copy; 2025 IRON STACK - Gym fitness | Made with Node.js & MongoDB</p>
    </footer>

</body>
</html>