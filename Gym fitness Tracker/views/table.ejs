<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/style.css">
    <title>Gym Management</title>
</head>
<body>

    <header class="gym-header">
        <h1>
        <span style="font-size: 30px;">❚█══█❚</span> IRON STACK
        </h1>
    </header>

    <section class="gym-banner">
        <div class="banner-text">TRANSFORM YOUR BODY</div>
    </section>

    <section class="container main-content">
        <h2 style="text-align: center; color: goldenrod; margin-bottom: 20px;">All Gym Members</h2>
        
        <table class="table table-hover table-dark table-striped">
            <thead>
                <tr>
                    <th scope="col">No</th>
                    <th scope="col">Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Gender</th>
                    <th scope="col">Mobile</th>
                    <th scope="col">Membership</th>
                    <th score="col">Price</th>
                    <th scope="col">Status</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                <% allMembers.map((member, index) => { %>
                <tr>
                    <th scope="row"><%= index + 1 %></th>
                    <td><%= member.fullName %></td>
                    <td><%= member.age %></td>
                    <td><%= member.gender %></td>
                    <td><%= member.mobile %></td>
                    <td><%= member.membershipType %></td>
                    <td><%= member.price %></td>
                    <td><%= member.status %></td>
                    <td>
                        <a href="/editMember/<%= member.id %>" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/deleteMember?id=<%= member.id %>" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <div style="text-align: center; margin-top: 20px;">
            <a href="/addMemberPage" class="btn btn-warning btn-lg">Add New Member</a>
        </div>
    </section>

    <footer class="gym-footer">
        <p>&copy; 2025 IRON STACK - Gym fitness | Made with Node.js & MongoDB</p>
    </footer>

</body>
</html>