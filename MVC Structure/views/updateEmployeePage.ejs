<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Employee</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body style="background-color: gainsboro">
    <div class="container">
      <h1 style="text-align: center; color: goldenrod; margin-top: 15px">
        Update Employee
      </h1>
      <div class="col-12 pt-5">
        <form method="post" action="/employee/update/<%= employee._id %>">
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Name</h5></label>
            <input type="text" class="form-control" name="employee_name" value="<%= employee.employee_name %>" placeholder="Enter Employee Name" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Email</h5></label>
            <input type="email" class="form-control" name="employee_email" value="<%= employee.employee_email %>" placeholder="Enter Employee Email Id" required />
            <div class="form-text">
              <small>We'll never share your email with anyone else.</small>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Password</h5></label>
            <input type="password" class="form-control" name="employee_password" value="<%= employee.employee_password %>" placeholder="Enter Employee Password" required />
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Salary</h5></label>
            <input type="number" class="form-control" name="employee_salary" value="<%= employee.employee_salary %>" placeholder="Enter Employee Salary" required />
          </div>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Designation</h5></label>
            <div>
              <select class="form-select" name="employee_designation" required>
                <% [
                "Select Employee Degination",
                "Owner",
                "CIO",
                "Company Secretary",
                "General manager",
                "Project manager",
                "Team Leader",
                "IT Teck Support",
                "Cloud Engineer",
                "DevOps Engineer",
                "Full Stack Developer",
                "Frontend Developer",
                "Backend Developer",
                "Senior Developer",
                "JuniorEngineer",
                "UI/UX Designer",
                "Receptionist"
                ].map((designation) => { %>
                <option value="<%= designation %>" <%= (employee.employee_designation) === designation ? 'selected' : '' %>><%= designation %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label"><h5>Employee Gender</h5></label>
            <br />
            <div>
              <input type="radio" class="form-check-input" name="employee_gender" value="male" <%= (employee.employee_gender) === 'male' ? 'checked' : '' %>
              />
              <label class="form-check-label">Male</label>
              <input type="radio" class="form-check-input" name="employee_gender" value="female"
                <%= (employee.employee_gender) === 'female' ? 'checked' : '' %>
              />
              <label class="form-check-label">Female</label>
            </div>
          </div>
        </div>
          <div class="mb-3">
            <label class="form-label"><h5>Employee Hobby</h5></label>
            <div>
              <% [ "Reading", "Riding", "Photography", "indoor Games", "Music", "Sport" ].map((hobby) => { %>
              <input type="checkbox" class="form-check-input" name="employee_hobby" value="<%= hobby %>"
                <%= (employee.employee_hobby && employee.employee_hobby.includes(hobby)) ? 'checked' : '' %>
              />
              <label class="form-check-label"><%= hobby %></label>
              <% }) %>
            </div>
          </div>
          <button type="submit" class="btn btn-success">Update</button>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>